# Contoh file konfigurasi environment SegarTani.
# Salin file ini menjadi .env.local dan isi nilainya.
# JANGAN commit .env.local ke repositori.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Panel Uji Jarak (Developer Only) ─────────────────────────────────────────
# Aktifkan hanya untuk pengujian lokal; jangan aktifkan di produksi (Vercel).
# Bila diset ke 'true', tombol preset jarak (7 km, 14 km, 15,1 km, dst.)
# akan tampil di halaman checkout untuk memudahkan pengujian presisi Haversine.
NEXT_PUBLIC_SHOW_TEST_PANEL=false
